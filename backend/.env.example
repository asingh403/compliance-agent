# Runtime
NODE_ENV=development
PORT=5001
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173
REQUEST_BODY_LIMIT=100kb
REQUIREMENT_MAX_LENGTH=10000
TRUST_PROXY_HOPS=0
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=20
REQUEST_TIMEOUT_MS=60000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGODB_DB_NAME=compliance_coverage
MONGODB_COLLECTION_GDPR=gdpr_clauses
MONGODB_COLLECTION_EU_AI=eu_ai_act_clauses
MONGODB_COLLECTION_ACTIVITY=activity_logs
ACTIVITY_RETENTION_DAYS=90
MONGODB_VECTOR_INDEX_GDPR=gdpr_vector_index
MONGODB_VECTOR_INDEX_EU_AI=eu_ai_act_vector_index
MONGODB_VECTOR_DIMENSIONS=1024
MONGODB_CONNECT_TIMEOUT_MS=10000

# Mistral embeddings
MISTRAL_API_KEY=<mistral-api-key>
MISTRAL_EMBED_MODEL=mistral-embed

# Groq reranking
GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=<configured-groq-model>
GROQ_TIMEOUT_MS=20000

# Cohere reranking fallback
CO_API_KEY=<cohere-api-key>
CO_RERANK_MODEL=rerank-v4.0-fast
CO_RERANK_TIMEOUT_MS=15000

# Sarvam speech-to-text (server-side only; synchronous API accepts up to 30 seconds)
SARVAM_API_KEY=<sarvam-api-key>
SARVAM_TIMEOUT_MS=30000
SARVAM_MODEL=saaras:v3
SARVAM_LANGUAGE_CODE=en-IN
SARVAM_AUDIO_MAX_BYTES=10485760

# Retrieval and scoring
TOP_K=20
VECTOR_TOP_K_MAX=50
VECTOR_SIMILARITY_THRESHOLD=0.65
VECTOR_NUM_CANDIDATES=200
RERANK_CANDIDATE_COUNT=10
RERANK_THRESHOLD=0.50
RERANK_MAX_CLAUSE_LENGTH=6000
COVERAGE_TARGET=3
INGEST_BATCH_SIZE=20

# Official legal sources and normalized staging
GDPR_SOURCE_URL=https://eur-lex.europa.eu/eli/reg/2016/679/oj/eng
EU_AI_ACT_SOURCE_URL=https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng
LEGAL_SOURCE_ALLOWED_HOSTS=eur-lex.europa.eu
SCRAPE_TIMEOUT_MS=30000
SCRAPE_DATA_DIR=./data
